  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#776a99", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#156729" }
    },
    {
      "name": "Regex / escapes",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#00635a" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#9e4624" }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#9e4624", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.conditional"
      ],
      "settings": { "foreground": "#8051bf", "fontStyle": "bold" }
    },
    {
      "name": "Flow control (return / raise / yield / await / break)",
      "scope": [
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.loop"
      ],
      "settings": { "foreground": "#8051bf", "fontStyle": "bold" }
    },
    {
      "name": "Storage / modifiers",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#684b8a" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#00635a" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": { "foreground": "#2b5f93" }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.magic"],
      "settings": { "foreground": "#2b5f93", "fontStyle": "italic" }
    },
    {
      "name": "Classes & types",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": { "foreground": "#724d00" }
    },
    {
      "name": "Inherited class",
      "scope": ["entity.other.inherited-class"],
      "settings": { "foreground": "#724d00", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": { "foreground": "#2f2b3a" }
    },
    {
      "name": "Object properties",
      "scope": [
        "meta.attribute.python",
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#684b8a" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#a93d80" }
    },
    {
      "name": "self / this / cls",
      "scope": ["variable.language", "variable.language.self", "variable.language.this"],
      "settings": { "foreground": "#8051bf", "fontStyle": "italic" }
    },
    {
      "name": "Constants",
      "scope": ["variable.other.constant", "variable.other.readwrite.alias"],
      "settings": { "foreground": "#9e4624" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#8051bf" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#684b8a", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#776a99" }
    },
    {
      "name": "Tag punctuation",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#9284b3" }
    },
    {
      "name": "HTML entities",
      "scope": ["constant.character.entity"],
      "settings": { "foreground": "#9e4624" }
    },
    {
      "name": "HTML doctype",
      "scope": ["meta.tag.sgml.doctype", "meta.tag.metadata.doctype"],
      "settings": { "foreground": "#9284b3", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "meta.function.decorator"
      ],
      "settings": { "foreground": "#94358e" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c13153" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#684b8a" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#2b5f93" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#724d00" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic", "foreground": "#684b8a" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#8051bf", "fontStyle": "bold" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw.block.markdown"],
      "settings": { "foreground": "#156729" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#00635a" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#776a99", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#156729" }
    },
    {
      "name": "YAML / TOML / INI keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.toml",
        "keyword.other.definition.ini",
        "entity.name.tag.ini"
      ],
      "settings": { "foreground": "#684b8a" }
    },
    {
      "name": "YAML anchors & aliases",
      "scope": ["punctuation.definition.anchor.yaml", "variable.other.alias.yaml", "entity.name.type.anchor.yaml"],
      "settings": { "foreground": "#94358e", "fontStyle": "italic" }
    },
    {
      "name": "Dockerfile instructions",
      "scope": ["keyword.other.special-method.dockerfile", "keyword.control.dockerfile"],
      "settings": { "foreground": "#8051bf", "fontStyle": "bold" }
    },
    {
      "name": "Shell — commands & builtins",
      "scope": ["support.function.builtin.shell", "entity.name.command.shell", "meta.function-call.shell"],
      "settings": { "foreground": "#2b5f93" }
    },
    {
      "name": "Shell — variables & interpolation",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell",
        "string.interpolated.dollar.shell"
      ],
      "settings": { "foreground": "#684b8a" }
    },
    {
      "name": "Shell — flags/options",
      "scope": ["constant.other.option.shell", "constant.other.option"],
      "settings": { "foreground": "#9e4624" }
    },
    {
      "name": "SQL keywords",
      "scope": ["keyword.other.DML.sql", "keyword.other.sql", "storage.type.sql"],
      "settings": { "foreground": "#8051bf", "fontStyle": "bold" }
    },
    {
      "name": "Env files",
      "scope": ["source.env variable.other", "source.dotenv variable.other", "keyword.other.definition.env"],
      "settings": { "foreground": "#684b8a" }
    },
    {
      "name": "CSS classes & ids",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#724d00" }
    },
    {
