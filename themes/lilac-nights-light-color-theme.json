    },
    {
      "name": "Markdown rule",
      "scope": ["meta.separator.markdown"],
      "settings": { "foreground": "#776a99" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#c13153" }
    }
  ],
  "semanticTokenColors": {
    "namespace": { "foreground": "#724d00", "italic": true },
