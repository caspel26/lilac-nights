    },
    {
      "name": "C# — built-in types",
      "scope": ["source.cs keyword.type"],
      "settings": { "foreground": "#81623b", "fontStyle": "italic" }
    },
    {
      "name": "C# — parameters",
      "scope": ["entity.name.variable.parameter.cs"],
      "settings": { "foreground": "#a93d80" }
    },
    {
      "name": "PHP — types",
      "scope": ["keyword.other.type.php"],
      "settings": { "foreground": "#81623b", "fontStyle": "italic" }
    },
    {
      "name": "PHP — attributes",
      "scope": ["meta.attribute.php"],
      "settings": { "foreground": "#94358e" }
    },
    {
      "name": "Vue — directives",
      "scope": ["meta.attribute.directive.vue entity.other.attribute-name.html.vue", "punctuation.attribute-shorthand.bind.html.vue", "punctuation.attribute-shorthand.event.html.vue", "punctuation.attribute-shorthand.slot.html.vue"],
      "settings": { "foreground": "#94358e" }
