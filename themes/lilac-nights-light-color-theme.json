    "variable.classMember.definition": { "foreground": "#2f2b3a", "italic": false },
    "property.declaration": { "foreground": "#2f2b3a", "italic": false },
    "property.definition": { "foreground": "#2f2b3a", "italic": false },
    "property.declaration.readonly": { "foreground": "#2f2b3a", "italic": true },
    "property.definition.readonly": { "foreground": "#2f2b3a", "italic": true },
    "variable.classMember.declaration.readonly": { "foreground": "#2f2b3a", "italic": true },
    "variable.classMember.definition.readonly": { "foreground": "#2f2b3a", "italic": true },
    "variable.readonly": { "foreground": "#9e4624" },
    "variable.defaultLibrary": { "foreground": "#9e4624", "italic": true },
    "parameter": { "foreground": "#a93d80" },
    "property": { "foreground": "#684b8a" },
    "property.readonly": { "foreground": "#684b8a", "italic": true },
    "selfParameter": { "foreground": "#8051bf", "italic": true },
