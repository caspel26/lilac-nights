    "variable.classMember.readonly": { "foreground": "#d7b8ff", "italic": true },
    "variable.classMember.declaration": { "foreground": "#e6e0f5", "italic": false },
    "variable.classMember.definition": { "foreground": "#e6e0f5", "italic": false },
    "property.declaration": { "foreground": "#e6e0f5", "italic": false },
    "property.definition": { "foreground": "#e6e0f5", "italic": false },
    "variable.readonly": { "foreground": "#ff9d7a" },
    "variable.defaultLibrary": { "foreground": "#ff9d7a", "italic": true },
    "parameter": { "foreground": "#fb92bb" },
    "property": { "foreground": "#d7b8ff" },
    "property.readonly": { "foreground": "#d7b8ff", "italic": true },
    "selfParameter": { "foreground": "#b98cff", "italic": true },
    "clsParameter": { "foreground": "#b98cff", "italic": true },

    "decorator": { "foreground": "#f18ce8" },
    "macro": { "foreground": "#f18ce8" },
    "modifier": { "foreground": "#d7b8ff" },
    "operator": { "foreground": "#5fe3d4" },

    "number": { "foreground": "#ff9d7a" },
    "regexp": { "foreground": "#5fe3d4" },
    "string": { "foreground": "#8fdc98" },
    "comment": { "foreground": "#8a7dad", "italic": true },

    "*.deprecated": { "strikethrough": true }
  }
