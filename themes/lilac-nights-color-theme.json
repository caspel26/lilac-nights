  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8a7dad", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#8fdc98" }
    },
    {
      "name": "Regex / escapes",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#5fe3d4" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ff9d7a" }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#ff9d7a", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.conditional"
      ],
      "settings": { "foreground": "#b98cff", "fontStyle": "bold" }
    },
    {
      "name": "Flow control (return / raise / yield / await / break)",
      "scope": [
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.loop"
      ],
      "settings": { "foreground": "#b98cff", "fontStyle": "bold" }
    },
    {
      "name": "Storage / modifiers",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#d7b8ff" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#5fe3d4" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": { "foreground": "#8ec5ff" }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.magic"],
      "settings": { "foreground": "#8ec5ff", "fontStyle": "italic" }
    },
    {
      "name": "Classes & types",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": { "foreground": "#ffcc80" }
    },
    {
      "name": "Inherited class",
      "scope": ["entity.other.inherited-class"],
      "settings": { "foreground": "#ffcc80", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": { "foreground": "#e6e0f5" }
    },
    {
      "name": "Object properties",
      "scope": [
        "meta.attribute.python",
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#d7b8ff" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#fb92bb" }
    },
    {
      "name": "self / this / cls",
      "scope": ["variable.language", "variable.language.self", "variable.language.this"],
      "settings": { "foreground": "#b98cff", "fontStyle": "italic" }
    },
    {
      "name": "Constants",
      "scope": ["variable.other.constant", "variable.other.readwrite.alias"],
      "settings": { "foreground": "#ff9d7a" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#b98cff" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#d7b8ff", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#8a7dad" }
    },
    {
      "name": "Tag punctuation",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#716490" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "meta.function.decorator"
      ],
      "settings": { "foreground": "#f18ce8" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff6b85" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#d7b8ff" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#8ec5ff" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#ffcc80" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic", "foreground": "#d7b8ff" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#b98cff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#8fdc98" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#5fe3d4" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#8a7dad", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#8fdc98" }
    },
    {
      "name": "YAML / TOML / INI keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.toml",
        "keyword.other.definition.ini",
        "entity.name.tag.ini"
      ],
      "settings": { "foreground": "#d7b8ff" }
    },
    {
      "name": "YAML anchors & aliases",
      "scope": ["punctuation.definition.anchor.yaml", "variable.other.alias.yaml", "entity.name.type.anchor.yaml"],
      "settings": { "foreground": "#f18ce8", "fontStyle": "italic" }
    },
    {
      "name": "Dockerfile instructions",
      "scope": ["keyword.other.special-method.dockerfile", "keyword.control.dockerfile"],
      "settings": { "foreground": "#b98cff", "fontStyle": "bold" }
    },
    {
      "name": "Shell — commands & builtins",
      "scope": ["support.function.builtin.shell", "entity.name.command.shell", "meta.function-call.shell"],
      "settings": { "foreground": "#8ec5ff" }
    },
    {
      "name": "Shell — variables & interpolation",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell",
        "string.interpolated.dollar.shell"
      ],
      "settings": { "foreground": "#d7b8ff" }
    },
    {
      "name": "Shell — flags/options",
      "scope": ["constant.other.option.shell", "constant.other.option"],
      "settings": { "foreground": "#ff9d7a" }
    },
    {
      "name": "SQL keywords",
      "scope": ["keyword.other.DML.sql", "keyword.other.sql", "storage.type.sql"],
      "settings": { "foreground": "#b98cff", "fontStyle": "bold" }
    },
    {
      "name": "Env files",
      "scope": ["source.env variable.other", "source.dotenv variable.other", "keyword.other.definition.env"],
      "settings": { "foreground": "#d7b8ff" }
    },
    {
      "name": "CSS classes & ids",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#ffcc80" }
    },
    {
      "name": "CSS values & units",
      "scope": ["support.constant.property-value.css", "keyword.other.unit.css", "constant.numeric.css"],
      "settings": { "foreground": "#ff9d7a" }
    },
    {
      "name": "TS/JS — template literal punctuation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#f18ce8" }
    },
    {
      "name": "TS/JS — imports/exports & module names",
      "scope": ["variable.other.readwrite.alias.ts", "entity.name.type.module"],
      "settings": { "foreground": "#ffcc80" }
    },
    {
      "name": "Git commit — summary & metadata",
      "scope": ["meta.scope.metadata.git-commit", "meta.scope.subject.git-commit"],
      "settings": { "foreground": "#e6e0f5" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff6b85" }
    }
  ],
  "semanticTokenColors": {
    "namespace": { "foreground": "#ffcc80", "italic": true },
    "class": { "foreground": "#ffcc80" },
    "class.defaultLibrary": { "foreground": "#ffcc80", "italic": true },
    "type": { "foreground": "#ffcc80" },
    "type.defaultLibrary": { "foreground": "#ffcc80", "italic": true },
    "interface": { "foreground": "#ffcc80" },
    "enum": { "foreground": "#ffcc80" },
    "enumMember": { "foreground": "#5fe3d4" },
    "struct": { "foreground": "#ffcc80" },
    "typeParameter": { "foreground": "#ffcc80", "italic": true },

    "function": { "foreground": "#8ec5ff" },
    "function.defaultLibrary": { "foreground": "#8ec5ff", "italic": true },
    "method": { "foreground": "#8ec5ff" },
    "method.defaultLibrary": { "foreground": "#8ec5ff", "italic": true },

    "variable": { "foreground": "#e6e0f5" },
